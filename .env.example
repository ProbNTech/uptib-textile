# ── Lead notification email (SMTP) ────────────────────────────────
# Where the "new lead" alert is sent from and to. LEADS_NOTIFY_EMAIL
# accepts a comma-separated list once you want more than one recipient.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USE_TLS="True"
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
DEFAULT_FROM_EMAIL=""
LEADS_NOTIFY_EMAIL=""

# ── Google Sheets (lead storage) ──────────────────────────────────
# Both spreadsheets must be shared with GOOGLE_CLIENT_EMAIL as an Editor.
# Leave GOOGLE_REGISTRATION_SHEET_ID empty to reuse the contact spreadsheet.
GOOGLE_CONTACT_SHEET_ID=""
GOOGLE_REGISTRATION_SHEET_ID=""
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Optional: send memberships and newsletter signups to their own spreadsheets.
# Both fall back to SUBMISSIONS_SHEET_ID, then to GOOGLE_CONTACT_SHEET_ID.
# GOOGLE_MEMBERSHIP_SHEET_ID=""
# GOOGLE_NEWSLETTER_SHEET_ID=""
